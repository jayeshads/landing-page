}
h1{
    font-size:32px;
    margin-bottom:15px;
}
p{
    color:#cbd5e1;
    line-height:1.6;
    margin-bottom:25px;
}
.features{
    text-align:left;
    margin-bottom:30px;
}
.features li{
    margin:12px 0;
    list-style:none;
}
button{
    width:100%;
    padding:16px;
    border:none;
    border-radius:12px;
    background:#2563eb;
    color:white;
    font-size:18px;
    cursor:pointer;
    transition:.3s;
}
button:hover{
    background:#1d4ed8;
